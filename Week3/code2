#include <Adafruit_NeoPixel.h>

#define LED_PIN    13  // GPIO 13 (Pin D13)
#define NUM_LEDS   10  // Jumlah LED yang mau dites

Adafruit_NeoPixel strip(NUM_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);

void setup() {
  strip.begin();
  strip.show(); // Matikan semua LED di awal
}

void loop() {
  // Nyalain LED satu per satu dengan warna merah
  for(int i = 0; i < NUM_LEDS; i++) {
    strip.setPixelColor(i, strip.Color(255, 0, 0)); // Merah (R, G, B)
    strip.show();
    delay(200);
  }

  delay(1000);

  // Matikan LED
  strip.clear();
  strip.show();
  delay(1000);
}